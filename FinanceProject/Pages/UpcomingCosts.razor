@page "/upcoming-costs"
@inject FinanceStateService Finance
@inject FinanceCalculator Calc
@using System.ComponentModel.DataAnnotations

<PageTitle>Upcoming Costs</PageTitle>

<h1 class="page-title">&#x1F4C5; Upcoming Costs</h1>

@if (_loaded)
{
    var monthlyTotals = Finance.UpcomingCosts
        .GroupBy(cost => new DateTime(cost.Date.Year, cost.Date.Month, 1))
        .OrderBy(group => group.Key)
        .Select(group => new { Month = group.Key, Amount = group.Sum(Calc.GetUncoveredUpcomingCostAmount) })
        .ToList();

    <h2 class="section-title">Upcoming Cost Totals by Month</h2>
    <p class="text-muted">All listed costs, less their linked savings pot allocations. Fully covered costs count as £0.</p>
    <div class="summary-list">
        @foreach (var month in monthlyTotals)
        {
            <div class="summary-item">
                <span class="summary-item__name">@month.Month.ToString("MMMM yyyy")</span>
                <span class="summary-item__amount">@month.Amount.ToGBP()</span>
            </div>
        }
    </div>
    <div class="total-bar">
        Overall total: <strong>@monthlyTotals.Sum(month => month.Amount).ToGBP()</strong>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="OpenAddForm" disabled="@(!_loaded)">+ Add Upcoming Cost</button>

@if (_showForm && _editingId == null)
{
    @EditorForm
}

@if (!_loaded)
{
    <div class="d-flex align-items-center gap-2 text-muted my-3">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Loading...
    </div>
}
else if (Finance.UpcomingCosts.Count == 0)
{
    <div class="empty-state">No upcoming costs added yet.</div>
}
else
{
    <div class="item-list">
        @foreach (var cost in Finance.UpcomingCosts.OrderBy(u => u.Date))
        {
            <div @key="cost.Id">
                @if (_showForm && _editingId == cost.Id)
                {
                    @EditorForm
                }
                else
                {
                    <div class="item-card @(cost.Date < DateTime.Today ? "item-card--past" : "")">
                        <div class="item-card__header">
                            <span class="item-card__name">@cost.Name</span>
                            <span class="item-card__amount">@cost.Amount.ToGBP()</span>
                        </div>
                        <div class="item-card__meta">@cost.Date.ToString("dd MMM yyyy")</div>
                        @if (cost.SavingsPotId is { } potId)
                        {
                            var linkedPot = Finance.SavingsSubPots.FirstOrDefault(p => p.Id == potId);
                            <div class="item-card__meta">Savings pot: @(linkedPot?.Name ?? "Unavailable") - Uncovered cost: @Calc.GetUncoveredUpcomingCostAmount(cost).ToGBP()</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(cost.Details))
                        {
                            <div class="item-card__details">@cost.Details</div>
                        }
                        <div class="item-card__actions">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditForm(cost)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmRemove(cost.Id)">Remove</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@if (_confirmRemoveId != null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog-simple">
            <p>Are you sure you want to remove this upcoming cost?</p>
            <div class="form-actions">
                <button class="btn btn-danger" @onclick="RemoveConfirmedAsync" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> }
                    Remove
                </button>
                <button class="btn btn-secondary" @onclick="() => _confirmRemoveId = null" disabled="@_saving">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loaded;
    private bool _saving;
    private bool _showForm;
    private Guid? _editingId;
    private Guid? _confirmRemoveId;
    private string? _formError;

    private UpcomingCost _form = new();

    private RenderFragment EditorForm => @<div class="form-card" @key="_form">
        <h2 class="form-card__title">@(_editingId == null ? "Add Upcoming Cost" : "Edit Upcoming Cost")</h2>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="_form.Name" placeholder="e.g. Car service" />
                <ValidationMessage For="() => _form.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Amount (£)</label>
                <InputNumber class="form-control" @bind-Value="_form.Amount" />
                <ValidationMessage For="() => _form.Amount" />
            </div>
            <div class="mb-3">
                <label class="form-label">Date</label>
                <InputDate class="form-control" @bind-Value="_form.Date" />
                <ValidationMessage For="() => _form.Date" />
            </div>
            <div class="mb-3">
                <label class="form-label">Details (optional)</label>
                <InputTextArea class="form-control" @bind-Value="_form.Details" rows="2" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="savings-pot">Savings pot (optional)</label>
                <InputSelect id="savings-pot" class="form-select" @bind-Value="_form.SavingsPotId">
                    <option value="">No savings pot</option>
                    @foreach (var pot in AvailableSavingsPots)
                    {
                        <option value="@pot.Id">@pot.Name (@pot.Amount.ToGBP())</option>
                    }
                    @if (_form.SavingsPotId is { } selectedId && !AvailableSavingsPots.Any(p => p.Id == selectedId))
                    {
                        <option value="@selectedId">Unavailable pot — select another pot or no pot</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _form.SavingsPotId" />
                <div class="form-text">Each pot can cover one upcoming cost. Calculations use the cost minus the pot's current allocation, with a minimum of £0. Linking does not withdraw savings.</div>
                <div class="form-text">Uncovered cost: @Calc.GetUncoveredUpcomingCostAmount(_form).ToGBP()</div>
            </div>
            @if (_formError != null)
            {
                <div class="alert alert-danger" role="alert">@_formError</div>
            }
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> }
                    Save
                </button>
                <button type="button" class="btn btn-secondary" @onclick="CancelForm" disabled="@_saving">Cancel</button>
            </div>
        </EditForm>
    </div>;

    private IEnumerable<SavingsSubPot> AvailableSavingsPots => Finance.SavingsSubPots
        .Where(p => !Finance.UpcomingCosts.Any(u => u.Id != _form.Id && u.SavingsPotId == p.Id))
        .OrderBy(p => p.Name);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Finance.LoadAsync();
            _loaded = true;
            StateHasChanged();
        }
    }

    private void OpenAddForm()
    {
        _form = new UpcomingCost();
        _formError = null;
        _editingId = null;
        _showForm = true;
    }

    private void OpenEditForm(UpcomingCost cost)
    {
        _form = new UpcomingCost
        {
            Id = cost.Id,
            Name = cost.Name,
            Amount = cost.Amount,
            Date = cost.Date,
            Details = cost.Details,
            SavingsPotId = cost.SavingsPotId
        };
        _formError = null;
        _editingId = cost.Id;
        _showForm = true;
    }

    private void CancelForm() { _showForm = false; _editingId = null; }

    private async Task SaveAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            if (_editingId == null)
                await Finance.AddUpcomingCostAsync(_form);
            else
                await Finance.UpdateUpcomingCostAsync(_form);
            _showForm = false;
            _editingId = null;
        }
        catch (ValidationException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmRemove(Guid id) => _confirmRemoveId = id;

    private async Task RemoveConfirmedAsync()
    {
        _saving = true;
        if (_confirmRemoveId != null)
            await Finance.RemoveUpcomingCostAsync(_confirmRemoveId.Value);
        _saving = false;
        _confirmRemoveId = null;
    }
}
