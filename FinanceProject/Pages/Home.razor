@page "/"
@inject FinanceStateService Finance
@inject FinanceCalculator Calc
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>

<h1 class="page-title">📊 Dashboard</h1>

@if (!_loaded)
{
    <div class="d-flex align-items-center gap-2 text-muted my-3">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Loading...
    </div>
}
else
{
    <div class="dashboard-grid">

        @if (Finance.BankBalance != 0)
        {
            <!-- FORECAST: NEXT MONTH (EXCLUDING NEXT MONTH INCOME) -->
            <div class="stat-card stat-card--featured @(Calc.NextMonthForecast(false) < 0 ? "stat-card--danger" : "stat-card--highlight")">
                <div class="stat-label stat-label--with-icon stat-label--headline">
                    <span class="stat-label__icon">📈</span>
                    Forecast after <b>@NextMonthName&apos;s</b> bills (<b>EXCLUDING</b> next month income)
                </div>

                <div class="stat-value">@Calc.NextMonthForecast(false).ToGBP()</div>
                <div class="stat-label">@((Calc.NextMonthForecast(false) + Calc.AllocatedSavings).ToGBP()) with allocated savings</div>

                <button class="btn btn-sm btn-outline-light mt-1"
                        @onclick="() => _showBreakdownNextMonth = !_showBreakdownNextMonth">
                    @(_showBreakdownNextMonth ? "Hide breakdown" : "Show breakdown")
                </button>

                @if (_showBreakdownNextMonth)
                {
                    <div class="stat-sub" style="margin-top:0.6rem;">
                        Bank balance: @Finance.BankBalance.ToGBP()<br />
                        − Remaining debits this month: @Calc.RemainingDirectDebits.ToGBP()<br />
                        − Pro-rated budget this month (@_budgetFractionPercent%): @Calc.ProRatedBudget.ToGBP()<br />
                        − Upcoming costs this month: @Calc.UpcomingCostsThisMonth.ToGBP()<br />
                        − @NextMonthName upcoming costs: @Calc.UpcomingCostsNextMonth.ToGBP()<br />
                        − @NextMonthName debits: @Calc.TotalDirectDebits.ToGBP()<br />
                        − Full monthly budget: @Calc.TotalBudget.ToGBP()<br />
                        − Credit cards: @Calc.CreditCardBalance.ToGBP()<br />
                        + One-off incoming payments (this + next month): @((Calc.OneOffIncomingThisMonth + Calc.OneOffIncomingNextMonth).ToGBP())<br />
                        + Unpaid income: @Calc.UnpaidIncome.ToGBP()<br />
                        + Unallocated savings: @Calc.UnallocatedSavings.ToGBP()
                    </div>
                }
            </div>

            <!-- FORECAST: NEXT MONTH (INCLUDING NEXT MONTH INCOME) -->
            <div class="stat-card stat-card--featured @(Calc.NextMonthForecast(true) < 0 ? "stat-card--danger" : "stat-card--highlight")">
                <div class="stat-label stat-label--with-icon stat-label--headline">
                    <span class="stat-label__icon">🧮</span>
                    Forecast after <b>@NextMonthName&apos;s</b> bills (<b>INCLUDING</b> next month income)
                </div>

                <div class="stat-value">@Calc.NextMonthForecast(true).ToGBP()</div>
                <div class="stat-label">@((Calc.NextMonthForecast(true) + Calc.AllocatedSavings).ToGBP()) with allocated savings</div>

                <button class="btn btn-sm btn-outline-light mt-1"
                        @onclick="() => _showBreakdownNextMonthIncIncome = !_showBreakdownNextMonthIncIncome">
                    @(_showBreakdownNextMonthIncIncome ? "Hide breakdown" : "Show breakdown")
                </button>

                @if (_showBreakdownNextMonthIncIncome)
                {
                    <div class="stat-sub" style="margin-top:0.6rem;">
                        Bank balance: @Finance.BankBalance.ToGBP()<br />
                        − Remaining debits this month: @Calc.RemainingDirectDebits.ToGBP()<br />
                        − Pro-rated budget this month (@_budgetFractionPercent%): @Calc.ProRatedBudget.ToGBP()<br />
                        − Upcoming costs this month: @Calc.UpcomingCostsThisMonth.ToGBP()<br />
                        − @NextMonthName upcoming costs: @Calc.UpcomingCostsNextMonth.ToGBP()<br />
                        − @NextMonthName debits: @Calc.TotalDirectDebits.ToGBP()<br />
                        − Full monthly budget: @Calc.TotalBudget.ToGBP()<br />
                        − Credit cards: @Calc.CreditCardBalance.ToGBP()<br />
                        + One-off incoming payments (this + next month): @((Calc.OneOffIncomingThisMonth + Calc.OneOffIncomingNextMonth).ToGBP())<br />
                        + Unpaid income: @Calc.UnpaidIncome.ToGBP()<br />
                        + Next month income: @Calc.TotalIncome.ToGBP()<br />
                        + Unallocated savings: @Calc.UnallocatedSavings.ToGBP()
                    </div>
                }
            </div>

            <!-- END OF MONTH WITHOUT INCOME -->
            <div class="stat-card @(Calc.EndOfMonthBalanceExcIncome < 0 ? "stat-card--danger" : "stat-card--success")">
                <div class="stat-label stat-label--with-icon"><span class="stat-label__icon">🏁</span> Bank balance end of this month <b>without</b> income</div>
                <div class="stat-value">@Calc.EndOfMonthBalanceExcIncome.ToGBP()</div>

                <button class="btn btn-sm btn-outline-light mt-1"
                        @onclick="() => _showBreakdownEndOfMonthExcIncome = !_showBreakdownEndOfMonthExcIncome">
                    @(_showBreakdownEndOfMonthExcIncome ? "Hide breakdown" : "Show breakdown")
                </button>

                @if (_showBreakdownEndOfMonthExcIncome)
                {
                    <div class="stat-sub" style="margin-top:0.4rem;">
                        Bank balance: @Finance.BankBalance.ToGBP()<br />
                        − Remaining debits: @Calc.RemainingDirectDebits.ToGBP()<br />
                        − Pro-rated budget: @Calc.ProRatedBudget.ToGBP()<br />
                        − Upcoming costs: @Calc.UpcomingCostsThisMonth.ToGBP()<br />
                        − Credit cards: @Calc.CreditCardBalance.ToGBP()
                    </div>
                }
            </div>

            <!-- END OF MONTH WITH INCOME -->
            <div class="stat-card @(Calc.EndOfMonthBalance < 0 ? "stat-card--danger" : "stat-card--success")">
                <div class="stat-label stat-label--with-icon"><span class="stat-label__icon">💸</span> Bank balance end of this month <b>with</b> income</div>
                <div class="stat-value">@Calc.EndOfMonthBalance.ToGBP()</div>

                <button class="btn btn-sm btn-outline-light mt-1"
                        @onclick="() => _showBreakdownEndOfMonth = !_showBreakdownEndOfMonth">
                    @(_showBreakdownEndOfMonth ? "Hide breakdown" : "Show breakdown")
                </button>

                @if (_showBreakdownEndOfMonth)
                {
                    <div class="stat-sub" style="margin-top:0.4rem;">
                        Bank balance: @Finance.BankBalance.ToGBP()<br />
                        − Remaining debits: @Calc.RemainingDirectDebits.ToGBP()<br />
                        − Pro-rated budget: @Calc.ProRatedBudget.ToGBP()<br />
                        − Upcoming costs: @Calc.UpcomingCostsThisMonth.ToGBP()<br />
                        + One-off incoming payments: @Calc.OneOffIncomingThisMonth.ToGBP()<br />
                        + Unpaid income: @Calc.UnpaidIncome.ToGBP()<br />
                        − Credit cards: @Calc.CreditCardBalance.ToGBP()
                    </div>
                }
            </div>

            <!-- ALLOCATED SAVINGS -->
            <div class="stat-card stat-card--muted">
                <div class="stat-label">Allocated savings commitments</div>
                <div class="stat-value">@Calc.AllocatedSavings.ToGBP()</div>

                <button class="btn btn-sm btn-outline-secondary mt-1"
                        @onclick="() => _showBreakdownNonUnallocated = !_showBreakdownNonUnallocated">
                    @(_showBreakdownNonUnallocated ? "Hide breakdown" : "Show breakdown")
                </button>

                @if (_showBreakdownNonUnallocated)
                {
                    <div class="stat-sub" style="margin-top:0.4rem;">
                        Not included in the projected balance.<br />
                        @foreach (var pot in Finance.SavingsSubPots)
                        {
                            <span>@pot.Name: @pot.Amount.ToGBP()</span><br />
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="stat-card stat-card--muted">
                <div class="stat-label">Forecast &amp; balance</div>
                <div class="stat-value">—</div>
                <div class="stat-sub"><a href="bank-balance">Enter your bank balance</a> to see forecasts</div>
            </div>
        }

        <!-- DISPOSABLE INCOME -->
        <div class="stat-card stat-card--muted">
            <div class="stat-label stat-label--with-icon"><span class="stat-label__icon">✨</span> Disposable income (monthly)</div>
            <div class="stat-value">@Calc.DisposableIncome.ToGBP()</div>

            <div class="stat-label" style="font-size:0.95em;margin-bottom:0.2rem;">
                Income (@Calc.IncomePct%) vs Outgoings (@Calc.OutgoingsPct%)
            </div>

            <div class="stat-sub" style="margin-top:0.4rem;">
                Total monthly income: @Calc.TotalIncome.ToGBP()<br />
                − Total direct debits: @Calc.TotalDirectDebits.ToGBP()<br />
                − Total monthly budget: @Calc.TotalBudget.ToGBP()
            </div>
        </div>

        <!-- DIRECT DEBITS -->
        <div class="stat-card">
            <div class="stat-label stat-label--with-icon"><span class="stat-label__icon">💳</span> Total monthly direct debits</div>
            <div class="stat-value">@Calc.TotalDirectDebits.ToGBP()</div>

            <button class="btn btn-sm btn-outline-secondary mt-1"
                    @onclick="() => _showBreakdownDirectDebits = !_showBreakdownDirectDebits">
                @(_showBreakdownDirectDebits ? "Hide breakdown" : "Show breakdown")
            </button>

            @if (_showBreakdownDirectDebits)
            {
                <div class="stat-sub" style="margin-top:0.4rem;">
                    @foreach (var dd in Finance.DirectDebits)
                    {
                        <span>@dd.Name: @dd.Amount.ToGBP()</span><br />
                    }
                </div>
            }
        </div>

        <!-- REMAINING DEBITS -->
        <div class="stat-card">
            <div class="stat-label stat-label--with-icon"><span class="stat-label__icon">⏳</span> Direct debits remaining this month</div>
            <div class="stat-value">@Calc.RemainingDirectDebits.ToGBP()</div>

            <button class="btn btn-sm btn-outline-secondary mt-1"
                    @onclick="() => _showBreakdownRemainingDebits = !_showBreakdownRemainingDebits">
                @(_showBreakdownRemainingDebits ? "Hide breakdown" : "Show breakdown")
            </button>

            @if (_showBreakdownRemainingDebits)
            {
                <div class="stat-sub" style="margin-top:0.4rem;">
                    From @DateTime.Today.ToString("dd MMM") to end of month:<br />
                    @foreach (var dd in Finance.DirectDebits.Where(d => d.DayOfMonth > DateTime.Today.Day))
                    {
                        <span>@dd.Name: @dd.Amount.ToGBP()</span><br />
                    }
                </div>
            }
        </div>

        <!-- REMAINING DEBITS + PRO-RATED BUDGET -->
        <div class="stat-card">
            <div class="stat-label stat-label--with-icon"><span class="stat-label__icon">🧭</span> Remaining debits + pro-rated budget</div>
            <div class="stat-value">@Calc.RemainingDirectDebits.ToGBP()</div>

            <button class="btn btn-sm btn-outline-secondary mt-1"
                    @onclick="() => _showBreakdownProRated = !_showBreakdownProRated">
                @(_showBreakdownProRated ? "Hide breakdown" : "Show breakdown")
            </button>

            @if (_showBreakdownProRated)
            {
                <div class="stat-sub" style="margin-top:0.4rem;">
                    Remaining debits: @Calc.RemainingDirectDebits.ToGBP()<br />
                    + Pro-rated budget (@_budgetFractionPercent%): @Calc.ProRatedBudget.ToGBP()
                </div>
            }
        </div>
    </div>

    <!-- DIRECT DEBITS LIST -->
    @if (Finance.DirectDebits.Count > 0)
    {
        <h2 class="section-title">Direct Debits</h2>
        <div class="summary-list">
            @foreach (var dd in Finance.DirectDebits.OrderBy(d => d.DayOfMonth))
            {
                <div class="summary-item @(dd.DayOfMonth > DateTime.Today.Day ? "summary-item--remaining" : "summary-item--past")">
                    <span class="summary-item__name">@dd.Name</span>
                    <span class="summary-item__meta">Day @dd.DayOfMonth</span>
                    <span class="summary-item__amount">@dd.Amount.ToGBP()</span>
                </div>
            }
        </div>
    }

    <!-- BUDGET CATEGORIES -->
    @if (Finance.BudgetCategories.Count > 0)
    {
        <h2 class="section-title">Monthly Budget</h2>
        <div class="summary-list">
            @foreach (var cat in Finance.BudgetCategories)
            {
                <div class="summary-item">
                    <span class="summary-item__name">@cat.Name</span>
                    <span class="summary-item__amount">@cat.MonthlyAmount.ToGBP()</span>
                </div>
            }
        </div>
    }

    <!-- UPCOMING COSTS -->
    @if (Finance.UpcomingCosts.Count > 0)
    {
        <h2 class="section-title">Upcoming Costs</h2>
        <div class="summary-list">
            @foreach (var cost in Finance.UpcomingCosts.OrderBy(u => u.Date))
            {
                <div class="summary-item @(cost.Date >= DateTime.Today ? "summary-item--remaining" : "summary-item--past")">
                    <span class="summary-item__name">@cost.Name</span>
                    <span class="summary-item__meta">@cost.Date.ToString("dd MMM yyyy")</span>
                    <span class="summary-item__amount">@cost.Amount.ToGBP()</span>
                </div>
            }
        </div>
    }

    <!-- ONE-OFF PAYMENTS -->
    @if (Finance.OneOffPayments.Count > 0)
    {
        <h2 class="section-title">One-Off Incoming Payments</h2>
        <div class="summary-list">
            @foreach (var payment in Finance.OneOffPayments.OrderBy(p => p.Date))
            {
                <div class="summary-item @(payment.Date >= DateTime.Today ? "summary-item--remaining" : "summary-item--past")">
                    <span class="summary-item__name">@payment.Name</span>
                    <span class="summary-item__meta">@payment.Date.ToString("dd MMM yyyy")</span>
                    <span class="summary-item__amount">@payment.Amount.ToGBP()</span>
                </div>
            }
        </div>
    }

    @if (Finance.DirectDebits.Count == 0 &&
         Finance.BudgetCategories.Count == 0 &&
         Finance.UpcomingCosts.Count == 0 &&
         Finance.OneOffPayments.Count == 0)
    {
        <div class="empty-state">
            <p>No data yet. Use the menu to add direct debits, budget categories, upcoming costs and one-off incoming payments.</p>
        </div>
    }
}

@code {
    private bool _loaded;
    private string _budgetFractionPercent = "0";

    private string NextMonthName => DateTime.Today.AddMonths(1).ToString("MMMM");

    // UI toggles
    private bool _showBreakdownDirectDebits;
    private bool _showBreakdownRemainingDebits;
    private bool _showBreakdownProRated;
    private bool _showBreakdownEndOfMonthExcIncome;
    private bool _showBreakdownEndOfMonth;
    private bool _showBreakdownNonUnallocated;
    private bool _showBreakdownNextMonth;
    private bool _showBreakdownNextMonthIncIncome;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Finance.LoadAsync();

            var today = DateTime.Today;
            var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
            var remainingDays = daysInMonth - today.Day + 1;
            _budgetFractionPercent = Math.Round((decimal)remainingDays / daysInMonth * 100, 0).ToString();

            _loaded = true;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
